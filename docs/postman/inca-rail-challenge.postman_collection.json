    },
    {
      "name": "Football",
      "item": [
        {
          "name": "List competitions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Competition list request accepted', function () {",
                  "    pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 202) {",
                  "    pm.test('Competition synchronization was queued', function () {",
                  "        pm.expect(pm.response.json().data.status).to.eql('queued');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/competitions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "competitions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Import competition (async)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Competition import request completed', function () {",
                  "    pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 202) {",
                  "    pm.test('Competition import is queued or processing', function () {",
                  "        pm.expect(['queued', 'processing']).to.include(pm.response.json().data.status);",
                  "    });",
                  "} else {",
                  "    pm.test('Competition import is already completed', function () {",
                  "        pm.expect(pm.response.json().data.status).to.eql('completed');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/competitions/{{competition_id}}/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "competitions",
                "{{competition_id}}",
                "import"
              ]
            }
          },
          "description": "Starts the asynchronous import of a competition. After receiving 202, use Get saved competition to monitor the local import_status.",
          "response": []
        },
        {
          "name": "Get saved competition",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Saved competition request completed', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/competitions/{{competition_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "competitions",
                "{{competition_id}}"
              ]
            }
          },
          "description": "Returns the competition saved locally, including its import_status. The external API is not called.",
          "response": []
        },
        {
          "name": "List saved teams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/team",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "team"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get saved team",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/team/{{team_id}}",
              "host": ["{{base_url}}"],
              "path": ["team", "{{team_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "List saved players",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/players",
              "host": ["{{base_url}}"],
              "path": ["players"]
            }
          },
          "response": []
        }
      ]
    }
