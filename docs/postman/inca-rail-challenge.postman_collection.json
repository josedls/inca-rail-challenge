        {
          "name": "Change user status",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", "status"]
            }
          },
          "response": []
        }
      ]
    },
