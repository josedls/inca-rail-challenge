              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"operations\",\n  \"permissions\": [\"competitions.view\", \"team.view\", \"players.view\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/roles/{{role_id}}",
              "host": ["{{base_url}}"],
              "path": ["roles", "{{role_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete role",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/roles/{{role_id}}",
              "host": ["{{base_url}}"],
              "path": ["roles", "{{role_id}}"]
            }
          },
          "response": []
